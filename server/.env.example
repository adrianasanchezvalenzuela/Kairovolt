# Copia a server/.env (ignorado por git). Nunca subas credenciales. Guía completa: docs/ZOHO_SETUP.md
#
# Datacenter de tu cuenta Zoho (deben coincidir los dos):
#   US: accounts.zoho.com + projectsapi.zoho.com      EU: .eu      IN: .in
#   AU: .com.au     JP: .jp     CA: .ca     SA: .sa     CN: .com.cn
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_PROJECTS_URL=https://projectsapi.zoho.com

# Self Client (api-console.zoho.com)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# ID del portal de Zoho Projects (se obtiene con GET /api/admin/zoho/portales)
ZOHO_PROJECTS_PORTAL_ID=

# Token de EMERGENCIA y para scripts (equivale a administrador). Con Supabase configurado el personal entra con correo y contraseña;
# puedes dejarlo vacío para deshabilitar este acceso. Valor largo y aleatorio.
ADMIN_TOKEN=
# Opcional: URL pública de la app para los enlaces de los correos de recuperación (si falta, se toma del origen de la petición).
# APP_URL=https://tu-dominio.com
# Opcional: clave para firmar las cookies de sesión (cambiarla cierra todas las sesiones). Si falta, se deriva de ADMIN_TOKEN o de la clave secreta de Supabase.
# SESSION_SECRET=

# Supabase. Guía: supabase/README.md
# Conexión a Postgres (Supabase → Connect → Transaction pooler, puerto 6543; mejor para Vercel/serverless).
# Lleva la contraseña de la base: es un secreto. Codifica en URL los caracteres raros (@ # / ...).
DATABASE_URL=

# API de Supabase (Connect → API keys). Con estas tres el personal inicia sesión con correo y contraseña y se administran los usuarios.
# SUPABASE_SECRET_KEY (sb_secret_...) se salta RLS: SOLO en el servidor, nunca en una variable VITE_ ni en el navegador.
SUPABASE_URL=https://xxxx.supabase.co   # sin /rest/v1/ ni / final
SUPABASE_PUBLISHABLE_KEY=   # valida correo y contraseña (sin ella no hay login por correo)
SUPABASE_SECRET_KEY=        # administra usuarios, perfiles y auditoría
# Para verificar el JWT de los usuarios de Supabase Auth en el backend.
SUPABASE_JWKS_URL=https://xxxx.supabase.co/auth/v1/.well-known/jwks.json

PORT=8787
